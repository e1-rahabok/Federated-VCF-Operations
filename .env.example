# Server Configuration
PORT=3000
NODE_ENV=development

# Database Settings
DATABASE_URL=file:./data/vcf_ops.db

# Security & Encryption
# Secret 32-byte hexadecimal key for AES-256-GCM encryption of VCF passwords
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Signs web session tokens. Leave empty to generate a random key at each start
# (users then sign in again after a restart). Set a long random value to keep sessions.
JWT_SECRET=
SESSION_HOURS=8

# First administrator account, created only when no user exists yet. Leave ADMIN_PASSWORD
# empty to have a random password generated and printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ingestion Engine Settings
POLLING_INTERVAL_SECONDS=60
RETENTION_RAW_HOURS=48
RETENTION_SUMMARY_DAYS=90
LOG_LEVEL=info

# Per-request timeout for VCF Operations API calls
API_TIMEOUT_SECONDS=15

# Lab only: allow an instance hostname to be written as http://host:port
ALLOW_INSECURE_HTTP=false

# Load a fictitious demo dataset into an empty database (demo instances are never polled)
SEED_DEMO_DATA=false
